# Copy to keystore.properties (never commit that file) to sign release builds.
# Create a key with:
#   keytool -genkeypair -keystore keystore/adochi-release.jks -storetype PKCS12 -alias adochi -keyalg RSA -keysize 4096 -validity 10000
# Keep the .jks file and these passwords backed up: updates must be signed with the same key.
storeFile=keystore/adochi-release.jks
storePassword=CHANGE_ME
keyAlias=adochi
keyPassword=CHANGE_ME
