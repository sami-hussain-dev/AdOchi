{
  "manifest_version": 3,
  "name": "AdOchi – Ad & Scam Blocker",
  "short_name": "AdOchi",
  "version": "1.0.0",
  "description": "Free ad, tracker and scam blocker by x8code. Removes sponsored posts and video ads on Facebook and YouTube. Nothing leaves your device.",
  "homepage_url": "https://x8code.com",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "scripting",
    "storage",
    "webNavigation"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "AdOchi",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ads", "enabled": true, "path": "rules/ads.json" },
      { "id": "paths", "enabled": true, "path": "rules/paths.json" },
      { "id": "threats", "enabled": true, "path": "rules/threats.json" }
    ]
  }
}
